{
  "name": "retro-messenger",
  "version": "0.16.1",
  "description": "Chat with Claude Code and ChatGPT like it's 2004: a retro instant-messenger desktop app",
  "main": "main.js",
  "author": "Wynfirdolf",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist:mac": "electron-builder --mac",
    "dist:win": "electron-builder --win",
    "install:mac": "electron-builder --mac --dir && codesign --force --deep --sign - \"dist/mac-arm64/Retro Messenger.app\" && rm -rf \"/Applications/Retro Messenger.app\" && ditto \"dist/mac-arm64/Retro Messenger.app\" \"/Applications/Retro Messenger.app\" && echo 'Kuruldu: /Applications/Retro Messenger.app'",
    "fonts": "node scripts/fetch-fonts.mjs"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "com.wynfirdolf.retromessenger",
    "productName": "Retro Messenger",
    "files": [
      "main.js",
      "preload.js",
      "src/**",
      "renderer/**"
    ],
    "mac": {
      "target": "dmg",
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": "nsis",
      "artifactName": "Retro-Messenger-Setup-${version}-${arch}.exe"
    },
    "publish": {
      "provider": "github",
      "owner": "wynfirdolf",
      "repo": "retro-messenger"
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/wynfirdolf/retro-messenger.git"
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
